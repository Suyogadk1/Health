PORT=5001

# Primary chat provider and Nepali audio transcription
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_API_KEY_2=
GEMINI_MODEL_2=gemini-3.6-flash
NEPALI_TRANSCRIPTION_MODEL=gemini-3.6-flash

# Groq transcription (Whisper) and optional Groq chat failover
GROQ_API_KEY=
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-20b

# Optional NVIDIA generation and safety review
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
HYBRID_RISK_CLASSIFIER=false
AI_STRATEGY=failover

# Female neural voices: install requirements-voice.txt
TTS_PYTHON=python

# Optional Supabase (review demo auth before public deployment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Neo4j retrieval
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
