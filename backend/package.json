{
  "name": "mindcare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js / Express API server for MindCare AI Companion",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run test:safety && npm run test:failover && npm run eval:ablation && npm run test:pipeline",
    "test:safety": "tsx eval/run_safety_eval.ts",
    "test:failover": "tsx eval/run_failover_eval.ts",
    "review:labels": "tsx eval/label_review.ts",
    "test:safety:live": "tsx eval/run_safety_eval.ts --live",
    "eval:ablation": "tsx eval/run_ablation.ts",
    "eval:failover-quality": "tsx eval/run_failover_quality_eval.ts",
    "eval:kappa": "tsx eval/cohens_kappa.ts",
    "seed:graph": "tsx scripts/seedGraph.ts",
    "test:pipeline": "tsx scripts/pipelineSmoke.ts",
    "test:safety:live-a": "tsx eval/run_safety_eval.ts --set=fresh --live-a"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.24.0",
    "serverless-http": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
