BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:5001

# Optional Supabase; never put private/service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Next.js API handlers only; standalone Express has separate configuration.
GUEST_MODE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_API_KEY_2=
GROK_API_KEY=
NVIDIA_API_KEY=
AI_STRATEGY=failover
